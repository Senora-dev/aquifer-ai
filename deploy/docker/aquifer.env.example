# Aquifer settings (AQUIFER_*). Full list: src/aquifer/core/config.py.

# Repositories to ingest (exact owner/repo names). Every MCP token can read all of them.
AQUIFER_GITHUB__REPO_ALLOWLIST=["your-org/your-repo"]
AQUIFER_NODE__SYNC_INTERVAL_S=900

# Bedrock (needs AWS credentials in the container: an instance/task role, or AWS_* variables).
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
AQUIFER_EMBEDDING__REGION=eu-west-1
AQUIFER_SEMANTIC_INDEX__REGION=eu-west-1
AQUIFER_SEMANTIC_INDEX__MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# No AWS at all: a lexical embedder and no LLM extraction (deterministic extraction still runs).
# AQUIFER_EMBEDDING__PROVIDER=hashing
# AQUIFER_SEMANTIC_INDEX__ENABLED=false
