#!/usr/bin/env bash
# aquifer-test — deploy, test and remove an Aquifer evaluation environment with Terraform.
#
#   ./aquifer-test check          prerequisites, AWS login, Bedrock model availability
#   ./aquifer-test seed           create private GitHub test repos from the demo data
#   ./aquifer-test configure      write terraform.tfvars (repos, region, models)
#   ./aquifer-test plan           build artifacts + terraform plan (creates nothing)
#   ./aquifer-test up             build + apply + store GitHub token + ingest + wait
#   ./aquifer-test ingest         run discovery now and wait until the queue drains
#   ./aquifer-test status         what is deployed and how ingestion is doing
#   ./aquifer-test test           end-to-end MCP checks (+ idempotency check)
#   ./aquifer-test test-updates   commit a change + a deletion to GitHub, re-ingest, verify, revert
#   ./aquifer-test connect        forward the internal MCP endpoint to localhost for your agent
#   ./aquifer-test token          print the MCP bearer token
#   ./aquifer-test logs <worker|discovery|mcp> [minutes]
#   ./aquifer-test down           terraform destroy (asks for confirmation)
#
# Environment: AQUIFER_REGION (default eu-west-1), AQUIFER_NAME (default aquifer-test),
# AQUIFER_EXTRACTION_MODEL (override auto-detection), AQUIFER_LOCAL_PORT (default 18080),
# AQUIFER_YES=1 (skip confirmations). Every command prints what it does; outputs that are
# useful to an AI agent are also printed as `KEY=value` lines.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
REGION="${AQUIFER_REGION:-eu-west-1}"
NAME="${AQUIFER_NAME:-aquifer-test}"
PORT="${AQUIFER_LOCAL_PORT:-18080}"
BUILD="$HERE/.build"
TF=(terraform -chdir="$HERE")
export AWS_REGION="$REGION" AWS_DEFAULT_REGION="$REGION" AWS_PAGER=""

say()  { printf '\033[1m==> %s\033[0m\n' "$*" >&2; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*" >&2; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '  \033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
confirm() {
  [[ "${AQUIFER_YES:-}" == "1" ]] && return 0
  read -r -p "$1 [y/N] " a; [[ "$a" == "y" || "$a" == "Y" ]]
}
tfout() { "${TF[@]}" output -raw "$1" 2>/dev/null; }

python_bin() {
  # A virtualenv with the aquifer package (needed for the e2e client and preflight).
  local venv="$ROOT/.venv"
  if [[ ! -x "$venv/bin/python" ]]; then
    say "creating $venv"
    local py; py="$(command -v python3.12 || command -v python3.11 || command -v python3)"
    "$py" -m venv "$venv"
    "$venv/bin/pip" install -q --upgrade pip
  fi
  if ! "$venv/bin/python" -c "import aquifer, mcp, httpx" 2>/dev/null; then
    "$venv/bin/pip" install -q -e "$ROOT[dev]"
  fi
  echo "$venv/bin/python"
}

# --- check -------------------------------------------------------------------------------------

cmd_check() {
  say "tools"
  for t in aws terraform docker gh python3; do
    command -v "$t" >/dev/null && ok "$t" || die "$t is not installed"
  done
  docker info >/dev/null 2>&1 && ok "docker daemon running" || die "start Docker"
  if command -v session-manager-plugin >/dev/null; then ok "session-manager-plugin"
  else warn "session-manager-plugin missing (needed by connect/test): brew install --cask session-manager-plugin"; fi
  gh auth status >/dev/null 2>&1 && ok "gh authenticated as $(gh api user -q .login)" || die "run: gh auth login"

  say "AWS ($REGION)"
  local arn
  arn="$(aws sts get-caller-identity --query Arn --output text 2>/dev/null)" \
    || die "AWS credentials missing or expired — run: aws sso login"
  ok "logged in as ${arn##*/}"
  aws opensearchserverless list-collections --max-results 1 >/dev/null 2>&1 \
    && ok "OpenSearch Serverless available" || die "OpenSearch Serverless unavailable in $REGION"

  say "Bedrock models"
  local embed="amazon.titan-embed-text-v2:0" extract
  extract="$(detect_extraction_model)"
  [[ -n "$extract" ]] || die "no Anthropic Claude model or inference profile found in $REGION"
  "$(python_bin)" - "$embed" "$extract" <<'PY'
import json, sys, boto3
embed, extract = sys.argv[1:3]
rt = boto3.client("bedrock-runtime")
try:
    rt.invoke_model(modelId=embed, body=json.dumps({"inputText": "aquifer check", "dimensions": 256}))
    print(f"  \033[32m✓\033[0m embedding model {embed} invocable", file=sys.stderr)
except Exception as e:
    sys.exit(f"  \033[31m✗ embedding model {embed}: {type(e).__name__}: {e}\033[0m")
try:
    rt.converse(modelId=extract, messages=[{"role": "user", "content": [{"text": "Reply OK"}]}],
                inferenceConfig={"maxTokens": 5})
    print(f"  \033[32m✓\033[0m extraction model {extract} invocable", file=sys.stderr)
except Exception as e:
    sys.exit(f"  \033[31m✗ extraction model {extract}: {type(e).__name__}: {e}\n"
             "    (enable model access in the Bedrock console, or set AQUIFER_EXTRACTION_MODEL)\033[0m")
PY
  echo "EXTRACTION_MODEL=$extract"
}

detect_extraction_model() {
  if [[ -n "${AQUIFER_EXTRACTION_MODEL:-}" ]]; then echo "$AQUIFER_EXTRACTION_MODEL"; return; fi
  # Prefer an active cross-region Claude Sonnet profile, then Haiku.
  aws bedrock list-inference-profiles --type-equals SYSTEM_DEFINED \
    --query "inferenceProfileSummaries[?status=='ACTIVE'].inferenceProfileId" --output text 2>/dev/null \
    | tr '\t' '\n' | grep 'anthropic.claude' \
    | awk '/sonnet/{print "1 " $0; next} /haiku/{print "2 " $0; next} {print "3 " $0}' \
    | sort -k1,1n -k2,2r | head -1 | cut -d' ' -f2
}

# --- seed / configure --------------------------------------------------------------------------

cmd_seed() {
  say "seeding private GitHub test repositories"; mkdir -p "$BUILD"
  "$HERE/scripts/seed-github-repos.sh" "${1:-}" "${2:-aquifer-test}" > "$BUILD/repos.json"
  cat "$BUILD/repos.json"
}

cmd_configure() {
  mkdir -p "$BUILD"
  local repos model
  if [[ -f "$BUILD/repos.json" ]]; then repos="$(cat "$BUILD/repos.json")"
  else
    local owner; owner="$(gh api user -q .login)"
    repos="[\"$owner/aquifer-test-payments\", \"$owner/aquifer-test-platform\", \"$owner/aquifer-test-legacy-billing\"]"
  fi
  model="$(detect_extraction_model)"
  [[ -n "$model" ]] || die "could not detect a Claude model in $REGION; set AQUIFER_EXTRACTION_MODEL"
  cat > "$HERE/terraform.tfvars" <<EOF
# Written by ./aquifer-test configure — edit freely.
name                = "$NAME"
region              = "$REGION"
repos               = $repos
extraction_model_id = "$model"
EOF
  ok "wrote terraform.tfvars"
  cat "$HERE/terraform.tfvars" >&2
}

# --- build -------------------------------------------------------------------------------------

image_tag() {
  # Content hash of everything that goes into the image, so unchanged code is not re-pushed.
  (cd "$ROOT" && { cat pyproject.toml README.md Dockerfile.mcp; find src -name '*.py' -type f | sort | xargs cat; } \
    | shasum | cut -c1-12)
}

cmd_build() {
  mkdir -p "$BUILD"
  say "building Lambda bundle (python3.12, arm64)"
  rm -rf "$BUILD/lambda" "$BUILD/wheels" && mkdir -p "$BUILD/lambda" "$BUILD/wheels"
  local py; py="$(python_bin)"
  "$py" -m pip wheel -q --no-deps -w "$BUILD/wheels" "$ROOT"
  local whl; whl="$(ls "$BUILD"/wheels/aquifer-*.whl)"
  "$py" -m pip install -q --target "$BUILD/lambda" --platform manylinux2014_aarch64 \
    --implementation cp --python-version 3.12 --only-binary=:all: --upgrade \
    "aquifer[ingestion] @ file://$whl"
  (cd "$BUILD/lambda" && rm -f ../lambda.zip && zip -qr9 ../lambda.zip . -x '*/__pycache__/*')
  ok "lambda.zip ($(du -h "$BUILD/lambda.zip" | cut -f1))"

  local tag; tag="aquifer-mcp:$(image_tag)"
  say "building MCP image $tag (linux/arm64)"
  docker buildx build --quiet --platform linux/arm64 -f "$ROOT/Dockerfile.mcp" -t "$tag" --load "$ROOT" >/dev/null
  ok "image built"
  echo "$tag" > "$BUILD/image_tag"
}

tf_vars() {
  echo -var="lambda_zip=.build/lambda.zip" -var="mcp_image_tag=$(cat "$BUILD/image_tag")"
}

cmd_plan() {
  [[ -f "$HERE/terraform.tfvars" ]] || cmd_configure
  cmd_build
  say "terraform plan (nothing is created)"
  "${TF[@]}" init -input=false -upgrade >/dev/null
  # shellcheck disable=SC2046
  "${TF[@]}" plan -input=false -out="$BUILD/plan.tfplan" $(tf_vars)
  "${TF[@]}" show -json "$BUILD/plan.tfplan" | "$(python_bin)" -c '
import json, sys, collections
plan = json.load(sys.stdin)
counts = collections.Counter(
    rc["type"] for rc in plan.get("resource_changes", [])
    if "create" in rc["change"]["actions"])
print("\nResources to create:", file=sys.stderr)
for t, n in sorted(counts.items()):
    print(f"  {n:3d}  {t}", file=sys.stderr)
print(f"  ---\n  {sum(counts.values()):3d}  total", file=sys.stderr)
'
  ok "plan saved to .build/plan.tfplan — './aquifer-test up' applies exactly this plan"
}

# --- up / ingest -------------------------------------------------------------------------------

cmd_up() {
  [[ -f "$BUILD/plan.tfplan" ]] || cmd_plan
  say "terraform apply (OpenSearch Serverless takes ~5-10 minutes)"
  "${TF[@]}" apply -input=false "$BUILD/plan.tfplan"
  rm -f "$BUILD/plan.tfplan"

  say "storing the GitHub token (from gh) in Secrets Manager — never in Terraform state"
  gh auth token | aws secretsmanager put-secret-value --secret-id "$(tfout github_token_secret_arn)" \
    --secret-string file:///dev/stdin >/dev/null
  ok "github token stored"

  say "waiting for the MCP service to become stable"
  aws ecs wait services-stable --cluster "$(tfout ecs_cluster)" --services "$(tfout ecs_service)"
  ok "MCP service running"
  cmd_ingest
  cmd_status
}

queue_depth() {
  aws sqs get-queue-attributes --queue-url "$1" \
    --attribute-names ApproximateNumberOfMessages ApproximateNumberOfMessagesNotVisible \
    --query 'Attributes.[ApproximateNumberOfMessages,ApproximateNumberOfMessagesNotVisible]' \
    --output text | awk '{print $1+$2}'
}

cmd_ingest() {
  say "running discovery now"
  local out; out="$(mktemp)"
  aws lambda invoke --function-name "$(tfout discovery_function)" --log-type None "$out" >/dev/null
  if grep -q errorMessage "$out"; then cat "$out" >&2; die "discovery failed"; fi
  ok "discovery: $(cat "$out")"
  say "waiting for the ingestion queue to drain"
  local q; q="$(tfout queue_url)"; local idle=0
  for _ in $(seq 1 120); do
    local d; d="$(queue_depth "$q")"
    if [[ "$d" == "0" ]]; then idle=$((idle + 1)); [[ $idle -ge 3 ]] && break; else idle=0; fi
    printf '  queue depth: %s\r' "$d" >&2; sleep 10
  done
  echo >&2
  local dlq; dlq="$(queue_depth "$(tfout dlq_url)")"
  [[ "$dlq" == "0" ]] && ok "queue drained, DLQ empty" || warn "DLQ has $dlq message(s) — see: ./aquifer-test logs worker"
  # OpenSearch Serverless makes writes searchable after its refresh interval.
  sleep 60
}

ingest_summary() {
  # Sum the worker's job_processed events since a given epoch-ms timestamp.
  aws logs filter-log-events --log-group-name "/aws/lambda/$(tfout worker_function)" \
    --start-time "$1" --filter-pattern '"job_processed"' --query 'events[].message' --output json \
  | "$(python_bin)" -c '
import json, sys, re, collections
tot = collections.Counter()
for m in json.load(sys.stdin):
    j = re.search(r"\{.*\}", m)
    if j:
        e = json.loads(j.group(0))
        for k in ("fetched", "indexed", "skipped", "failed", "deleted"):
            tot[k] += e.get(k, 0)
print(json.dumps(dict(tot)))'
}

cmd_status() {
  say "deployment ($REGION)"
  "${TF[@]}" output 2>/dev/null | grep -v -i token || die "nothing deployed"
  say "ingestion"
  echo "  queue depth: $(queue_depth "$(tfout queue_url)")   DLQ: $(queue_depth "$(tfout dlq_url)")" >&2
  echo "  last hour: $(ingest_summary $(( ($(date +%s) - 3600) * 1000 )))" >&2
  local running
  running="$(aws ecs describe-services --cluster "$(tfout ecs_cluster)" --services "$(tfout ecs_service)" \
    --query 'services[0].runningCount' --output text)"
  echo "  MCP tasks running: $running" >&2
}

# --- connect / test ----------------------------------------------------------------------------

mcp_token() {
  aws secretsmanager get-secret-value --secret-id "$(tfout mcp_auth_secret_arn)" \
    --query SecretString --output text | "$(python_bin)" -c 'import json,sys; print(json.load(sys.stdin)["default"])'
}

cmd_token() { mcp_token; }

start_forward() {
  command -v session-manager-plugin >/dev/null \
    || die "install the AWS Session Manager plugin: brew install --cask session-manager-plugin"
  if nc -z 127.0.0.1 "$PORT" 2>/dev/null; then return 0; fi
  aws ssm start-session --target "$(tfout test_client_instance_id)" \
    --document-name AWS-StartPortForwardingSessionToRemoteHost \
    --parameters "{\"host\":[\"$(tfout mcp_endpoint)\"],\"portNumber\":[\"80\"],\"localPortNumber\":[\"$PORT\"]}" \
    > "$BUILD/forward.log" 2>&1 &
  echo $! > "$BUILD/forward.pid"
  for _ in $(seq 1 30); do nc -z 127.0.0.1 "$PORT" 2>/dev/null && return 0; sleep 1; done
  cat "$BUILD/forward.log" >&2; die "port forward did not start"
}

stop_forward() {
  [[ -f "$BUILD/forward.pid" ]] && kill "$(cat "$BUILD/forward.pid")" 2>/dev/null || true
  rm -f "$BUILD/forward.pid"
}

cmd_connect() {
  start_forward
  local url="http://127.0.0.1:$PORT/mcp"
  ok "MCP endpoint forwarded to $url (stop with: kill \$(cat $BUILD/forward.pid))"
  cat >&2 <<EOF

Connect Claude Code (token is read from Secrets Manager, not stored in the config):
  claude mcp add --transport http aquifer-test $url --header "Authorization: Bearer \$(./aquifer-test token)"

Then ask: "What depends on billing-api, and where is that defined?"
EOF
  echo "MCP_URL=$url"
}

cmd_test() {
  local py; py="$(python_bin)"
  start_forward
  trap stop_forward EXIT
  local repos expect_llm=()
  repos="$("${TF[@]}" output -json repos | "$py" -c 'import json,sys; print(" ".join(json.load(sys.stdin)))')"
  grep -q 'semantic_index_enabled *= *false' "$HERE/terraform.tfvars" 2>/dev/null || expect_llm=(--expect-llm)

  say "end-to-end MCP checks"
  # shellcheck disable=SC2086
  "$py" "$HERE/tests/e2e.py" --url "http://127.0.0.1:$PORT/mcp" --token "$(mcp_token)" \
    --repos $repos "${expect_llm[@]}" "$@" --json-out "$BUILD/e2e-report.json"

  say "idempotency: a second ingestion must re-index nothing"
  local since; since=$(( $(date +%s) * 1000 ))
  cmd_ingest
  local summary; summary="$(ingest_summary "$since")"
  echo "  $summary" >&2
  "$py" -c "import json,sys; s=json.loads(sys.argv[1]); sys.exit(0 if s.get('indexed',0)==0 and s.get('failed',0)==0 and s.get('skipped',0)>0 else 1)" "$summary" \
    && ok "unchanged documents skipped (no Bedrock calls)" || die "re-ingestion indexed or failed documents: $summary"
  ok "report: $BUILD/e2e-report.json"
}

cmd_test_updates() {
  local payments; payments="$("${TF[@]}" output -json repos | "$(python_bin)" -c 'import json,sys; print(json.load(sys.stdin)[0])')"
  local work; work="$(mktemp -d)"
  say "committing a change (redis → valkey) and deleting the ADR in $payments"
  gh repo clone "$payments" "$work/r" -- -q
  sed -i.bak 's/      - redis/      - valkey/' "$work/r/docker-compose.yml" && rm "$work/r/docker-compose.yml.bak"
  git -C "$work/r" rm -q docs/adr/0007-ledger-on-postgres.md
  git -C "$work/r" -c user.name=aquifer-test -c user.email=aquifer-test@users.noreply.github.com \
    commit -qam "test: change a dependency and delete an ADR"
  git -C "$work/r" push -q
  cmd_ingest
  cmd_test --after-mutation || { warn "update checks failed"; }
  say "reverting the test commit"
  git -C "$work/r" revert --no-edit HEAD >/dev/null
  git -C "$work/r" push -q
  cmd_ingest
  rm -rf "$work"
}

# --- logs / down -------------------------------------------------------------------------------

cmd_logs() {
  local which="${1:-worker}" minutes="${2:-30}" group
  case "$which" in
    worker) group="/aws/lambda/$(tfout worker_function)" ;;
    discovery) group="/aws/lambda/$(tfout discovery_function)" ;;
    mcp) group="$(tfout mcp_log_group)" ;;
    *) die "logs <worker|discovery|mcp> [minutes]" ;;
  esac
  aws logs tail "$group" --since "${minutes}m" --format short
}

cmd_down() {
  say "this destroys every resource of '$NAME' in $REGION (indexed data included)"
  confirm "Destroy?" || die "aborted"
  stop_forward
  "${TF[@]}" destroy -input=false -auto-approve \
    -var="lambda_zip=.build/lambda.zip" -var="mcp_image_tag=$(cat "$BUILD/image_tag" 2>/dev/null || echo aquifer-mcp:none)"
  ok "destroyed. Test repos remain on GitHub; delete with: gh repo delete <owner>/aquifer-test-<name> --yes"
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    check) cmd_check ;;
    seed) cmd_seed "$@" ;;
    configure) cmd_configure ;;
    build) cmd_build ;;
    plan) cmd_plan ;;
    up) cmd_up ;;
    ingest) cmd_ingest ;;
    status) cmd_status ;;
    test) cmd_test "$@" ;;
    test-updates) cmd_test_updates ;;
    connect) cmd_connect ;;
    token) cmd_token ;;
    logs) cmd_logs "$@" ;;
    down) cmd_down ;;
    *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
  esac
}

main "$@"
