# Aquifer single-server image: MCP server, scheduler and ingestion workers in one process, with
# the SQLite index on a volume. Runs on any Docker host, VM or Kubernetes; see deploy/docker/.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --upgrade pip && pip install ".[server]" && rm -rf /app/src

RUN useradd --system --uid 10001 --home-dir /data aquifer \
    && mkdir -p /data && chown aquifer:aquifer /data
USER 10001
VOLUME ["/data"]

# Defaults for the single-server profile. Credentials are references (file:, env:, ssm:),
# never values; see src/aquifer/core/secrets.py.
ENV AQUIFER_VECTOR_STORE__BACKEND=sqlite \
    AQUIFER_VECTOR_STORE__SQLITE_PATH=/data/index.db \
    AQUIFER_NODE__DATA_DIR=/data \
    AQUIFER_MCP__HOST=0.0.0.0 \
    AQUIFER_MCP__PORT=8080 \
    AQUIFER_INTERCEPTORS='["aquifer.semantic.interceptor:SemanticIndexInterceptor"]'

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD python -c "import urllib.request,sys; sys.exit(urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=4).status != 200)"

# `init` creates the MCP token at AQUIFER_MCP__AUTH_TOKENS_REF if it does not exist yet.
CMD ["sh", "-c", "aquifer init && exec aquifer serve"]
